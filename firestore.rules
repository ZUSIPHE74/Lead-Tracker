rules_version = '2';

// All reads and writes go through the Express API (functions/), which uses the
// Admin SDK. The Admin SDK bypasses these rules, so clients get no direct access:
// otherwise anyone who signs up with the public web API key could read and write
// leads, bypassing the API's domain and role checks.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
