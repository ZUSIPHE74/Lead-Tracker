# Copy to functions/.env for local runs (never commit .env or the key file).
# Load with: node --env-file=.env lib/server.js

# Firebase project the API talks to. Same project as the web app.
FIREBASE_PROJECT_ID=moderntech-hr

# Path to a service-account JSON key (Firebase console → Project settings →
# Service accounts → Generate new private key). Free on the Spark plan.
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json

# Comma-separated browser origins allowed by CORS. Outside NODE_ENV=production,
# http://localhost:4200 is always allowed.
ALLOWED_ORIGINS=

# Only ID tokens for emails ending in this domain are accepted (403 otherwise).
ALLOWED_EMAIL_DOMAIN=@moderntech.co.za

# true = on startup, create/reset the demo.admin@, demo.manager@, demo.agent@ accounts
# with the passwords in src/features/admin/demo-accounts.ts. Run once, then set back.
SEED_DEMO_ACCOUNTS=false

# true = demo.* accounts may sign in and the login page shows the demo shortcuts.
# Staging/demos only. Never enable in production.
DEMO_MODE=false

PORT=4000
