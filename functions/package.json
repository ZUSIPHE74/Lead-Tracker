{
  "name": "functions",
  "description": "ModernTech HR Lead Tracker API — Express server (replaces Firebase Cloud Functions)",
  "scripts": {
    "lint": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "start": "node lib/server.js",
    "dev": "ts-node-dev --respawn --transpile-only server.ts",
    "test": "npm run build && node --test \"lib/**/*.test.js\""
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "main": "lib/server.js",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "firebase-admin": "^13.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "private": true
}
